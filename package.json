{
  "name": "dsh-whale-pixel-pet",
  "version": "1.0.0",
  "private": true,
  "description": "像素鲸鱼娘桌宠 for DeepSeek Harness：常驻 GUI 的互动伙伴，跟着会话忙闲换姿势，按 Token 用量成长",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "desktop",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/engine.test.mjs test/art.test.mjs test/actions.test.mjs test/status.test.mjs test/host.test.mjs"
  },
  "license": "MIT",
  "author": "1TRYOUT",
  "repository": { "type": "git", "url": "git+https://github.com/1TRYOUT/dsh-whale-pixel-pet.git" },
  "homepage": "https://github.com/1TRYOUT/dsh-whale-pixel-pet#readme",
  "bugs": { "url": "https://github.com/1TRYOUT/dsh-whale-pixel-pet/issues" },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "mascot",
    "pixel-art"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "note": "在 DeepSeek Harness 桌面端（Electron 壳，内嵌 DSH 0.2.0-rc.2）上开发并验证：桌宠可见、会话忙闲联动、设置面板注册、零外部请求。"
    }
  }
}
